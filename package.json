{
  "name": "git-plus-plus",
  "productName": "Git++",
  "version": "1.0.0",
  "description": "Git, but plus plus. A modern, safe desktop Git client.",
  "author": {
    "name": "Git++ Contributors",
    "email": "maintainers@gitplusplus.invalid"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main/electron.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "harness": "node scripts/harness.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "package": "npm run build && electron-builder --win --x64",
    "package:dir": "npm run build && electron-builder --win --x64 --dir",
    "package:win:unpacked:cross": "npm run build && electron-builder --win --x64 --dir -c.win.signAndEditExecutable=false",
    "package:win:zip:cross": "npm run build && electron-builder --win zip --x64 -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
